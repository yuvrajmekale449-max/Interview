# =========================================================
# FILE NAME : webserver.yml
# PURPOSE   : Install and Configure Nginx Web Server
# =========================================================

---
# Playbook starts here
- name: Install and Configure Nginx

  # Target server group from inventory
  hosts: web

  # Run tasks as sudo/root user
  become: yes

  # Variables section
  vars:

    # Package name variable
    package_name: nginx

    # Service name variable
    service_name: nginx

  # Tasks section
  tasks:

    # -----------------------------------------------------
    # Update package manager cache
    # -----------------------------------------------------
    - name: Update apt cache

      # apt module used in Ubuntu/Debian
      apt:
        update_cache: yes

    # -----------------------------------------------------
    # Install nginx package
    # -----------------------------------------------------
    - name: Install nginx

      # Package installation
      apt:

        # Package name
        name: "{{ package_name }}"

        # Ensure package installed
        state: present

    # -----------------------------------------------------
    # Start nginx service
    # -----------------------------------------------------
    - name: Start nginx service

      # Service module
      service:

        # Service name
        name: "{{ service_name }}"

        # Start service
        state: started

        # Enable service on boot
        enabled: yes

    # -----------------------------------------------------
    # Copy custom webpage
    # -----------------------------------------------------
    - name: Copy index.html file

      # Copy module
      copy:

        # Source file from Ansible server
        src: index.html

        # Destination path in target server
        dest: /var/www/html/index.html

      # Notify handler if file changes
      notify:
        - Restart nginx

  # ======================================================
  # Handlers Section
  # Handlers run only when notified
  # ======================================================
  handlers:

    - name: Restart nginx

      # Restart service
      service:
        name: nginx
        state: restarted

# =========================================================
# IMPORTANT INTERVIEW NOTES
# =========================================================

# hosts
# -----
# Defines target servers from inventory file.

# become
# -------
# Used for sudo/root privileges.

# vars
# ----
# Stores reusable variables.

# tasks
# -----
# List of operations executed sequentially.

# handlers
# --------
# Triggered only when notified.
# Mostly used for service restart.

# notify
# ------
# Calls handler when task changes.

# state: present
# --------------
# Ensures package installed.

# state: absent
# -------------
# Removes package.

# enabled: yes
# ------------
# Starts service automatically after reboot.

# Idempotency
# ------------
# Running playbook multiple times gives same result.

# Agentless
# ----------
# Ansible uses SSH. No agent required.

# YAML Rules
# -----------
# Uses spaces only.
# No tabs allowed.

